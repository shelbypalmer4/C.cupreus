# Peak frequency function
peakfreq <- function(sound, section) {
# compute over only first or second song section
if (section == "first") {
spect_fir <- meanspec(sound,
from = 0,
to = duration(sound)*0.47,
wl = 1024, ovlp = 98,
plot = F)
}
if (section == "second") {
spect_fir <- meanspec(sound,
from = duration(sound)*0.47,
to = duration(sound),
wl = 1024, ovlp = 98,
plot = F)
}
if (is.null(section)) {
meanspec(sound, wl = 1024, ovlp = 98, plot = F)
}
# return peak frequency
return(
spect_fir[which(spect_fir[,2]==max(spect_fir[,2])),1]
)
}
for (i in 1:length(list.files())) {
test <- readWave(list.files()[i])
# sig <- timer(test,
#              threshold = 25, dmin = 0.005,
#              msmooth = c(256, 95))
# print(length(sig$s)/max(sig$s))
# print(sd(sig$s))
print(peakfreq(test))
}
for (i in 1:length(list.files())) {
test <- readWave(list.files()[i])
# sig <- timer(test,
#              threshold = 25, dmin = 0.005,
#              msmooth = c(256, 95))
# print(length(sig$s)/max(sig$s))
# print(sd(sig$s))
print(peakfreq(test, section = NULL))
}
# Peak frequency function
peakfreq <- function(sound, section) {
# compute over only first or second song section
if (section == "first") {
spect_fir <- meanspec(sound,
from = 0,
to = duration(sound)*0.47,
wl = 1024, ovlp = 98,
plot = F)
}
if (section == "second") {
spect_fir <- meanspec(sound,
from = duration(sound)*0.47,
to = duration(sound),
wl = 1024, ovlp = 98,
plot = F)
}
if (section == "whole") {
meanspec(sound, wl = 1024, ovlp = 98, plot = F)
}
# return peak frequency
return(
spect_fir[which(spect_fir[,2]==max(spect_fir[,2])),1]
)
}

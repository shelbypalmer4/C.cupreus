# 22 May 2026: Write a function that defines frequencies by measuring down from the peak (the old way)
fspec_crit <- function(sound, section, crit) {
# compute over only first or second song section
if (section == "first") {
spect_fir <- meanspec(sound,
from = 0,
to = duration(sound)*0.47,
wl = 1024, ovlp = 98,
dB = "max0",
plot = F)
}
if (section == "second") {
spect_fir <- meanspec(sound,
from = duration(sound)*0.47,
to = duration(sound),
wl = 1024, ovlp = 98,
dB = "max0",
plot = F)
}
if (section == "whole") {
spect_fir <- meanspec(sound, wl = 1024, ovlp = 98, plot = F)
}
# return frequency spectrum above the critical value
return(
spect_fir[which(spect_fir[,2]>crit),1]
)
}
for (i in 1:length(list.files())) {
test <- readWave(list.files()[i])
# sig <- timer(test,
#              threshold = 25, dmin = 0.005,
#              msmooth = c(256, 95))
# print(length(sig$s)/max(sig$s))
# print(sd(sig$s))
print(min(fspec_crit(test, section = "whole")))
}
for (i in 1:length(list.files())) {
test <- readWave(list.files()[i])
# sig <- timer(test,
#              threshold = 25, dmin = 0.005,
#              msmooth = c(256, 95))
# print(length(sig$s)/max(sig$s))
# print(sd(sig$s))
print(min(fspec_crit(test, crit = -20, section = "whole")))
}
